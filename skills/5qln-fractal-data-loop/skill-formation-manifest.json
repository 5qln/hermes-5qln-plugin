  "contract": {
    "behavioral_requirements": [
      {
        "id": "REQ_REDUCE_SEED",
        "statement": "Given data of any size, reduce produces a bounded seed: spine within node budget, root hash, and a source-tagged return question.",
        "verification": "observed"
      },
      {
        "id": "REQ_EXPAND_VERIFY",
        "statement": "Witness expansion regenerates the exact bytes with ≡ re-verified at every level; essence expansion emits a verbatim outline at dialed depth, self-negating.",
        "verification": "observed"
      },
      {
        "id": "REQ_EMPTY_REFUSAL",
        "statement": "Empty input is refused: no seed is manufactured from nothing.",
        "verification": "observed"
      },
      {
        "id": "REQ_SCOPE_BOUNDARY",
        "statement": "Requests for vertical cycle descent do not trigger this skill — it is the data operator, not the unshipped sub-phase engine.",
        "verification": "observed"
      },
      {
        "id": "REQ_RECOGNITION_BOUNDARY",
        "statement": "The operator never certifies aliveness or essence-recognition; those remain with the human.",
        "verification": "observed"
      },
      {
        "id": "REQ_REMOVAL_TEST",
        "statement": "Each mechanism is causally load-bearing and the skill can say what breaks when each is removed.",
        "verification": "observed"
      }
    ],
