{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://5qln.com/schemas/tool-trace-v1.schema.json",
  "title": "5QLN observed tool trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "events"
  ],
  "properties": {
    "format_version": {
      "const": "tool-trace-v1"
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "tool",
        "arguments_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "tool": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
        },
        "arguments_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
