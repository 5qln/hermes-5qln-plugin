{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://5qln.com/schemas/skill-report-v1.schema.json",
  "title": "5QLN skill verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "execution_success",
    "manifest",
    "skill",
    "structural_status",
    "behavioral_status",
    "attestation_status",
    "human_review_status",
    "requested_state",
    "promotion_state",
    "promotion_ready",
    "counts",
    "checks",
    "errors",
    "warnings",
    "observations",
    "conversion_report",
    "limitations"
  ],
  "properties": {
    "format_version": {
      "const": "skill-report-v1"
    },
    "execution_success": {
      "type": "boolean"
    },
    "manifest": {
      "$ref": "#/$defs/subjectFile"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bundle_root",
        "bundle_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "bundle_root": {
          "const": "."
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "structural_status": {
      "enum": [
        "not_run",
        "failed",
        "passed"
      ]
    },
    "behavioral_status": {
      "enum": [
        "not_declared",
        "not_observed",
        "observed_failed",
        "observed_mixed",
        "observed_passed"
      ]
    },
    "attestation_status": {
      "enum": [
        "open",
        "evidence_present"
      ]
    },
    "human_review_status": {
      "enum": [
        "open",
        "changes_requested",
        "accepted"
      ]
    },
    "promotion_state": {
      "enum": [
        "draft",
        "blocked",
        "structurally_conformant",
        "behaviorally_observed",
        "human_reviewed",
        "promotion_ready",
        "withdrawn"
      ]
    },
    "promotion_ready": {
      "type": "boolean"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors",
        "warnings",
        "observations"
      ],
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "conversion_report": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "requested_state": {
      "enum": [
        "draft",
        "review_requested",
        "promotion_requested",
        "withdrawn"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subjectFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run",
            "unsupported"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "dimension",
        "code",
        "path",
        "message",
        "evidence"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "dimension": {
          "enum": [
            "structure",
            "behavior",
            "attestation",
            "promotion",
            "execution"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_/-]{2,127}$"
        },
        "path": {
          "type": "string",
          "maxLength": 1000
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "run_id",
        "status",
        "evidence"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "inapplicable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
