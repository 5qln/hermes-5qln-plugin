  "contract": {
    "triggers": [
      {
        "id": "TR_1",
        "statement": "An evolution cycle has run (S → G → Q → P → V) and its trace/proposal needs scanning",
        "authorship": "K"
      },
      {
        "id": "TR_2",
        "statement": "H asks \"check this for corruption\", \"watch this cycle\", \"L-scan this\"",
        "authorship": "K"
      },
      {
        "id": "TR_3",
        "statement": "A promotion diff or evidence set is presented for review",
        "authorship": "K"
      },
      {
        "id": "TR_4",
        "statement": "The self-evolution orchestrator invokes this skill post-cycle (line 9: L1 L2 L3 L4 V∅)",
        "authorship": "K"
      }
    ],
    "non_triggers": [
      {
        "id": "NTR_1",
        "statement": "Certifying, validating, or blessing any trace as \"clean 5QLN\" (L3 — false authority)",
        "authorship": "K"
      },
      {
        "id": "NTR_2",
        "statement": "Originating the next question, judging resonance, or naming Z",
        "authorship": "K"
      },
      {
        "id": "NTR_3",
        "statement": "Editing the kernel, the seal, or any invariant",
        "authorship": "K"
      },
      {
        "id": "NTR_4",
        "statement": "Silently passing a trace because it looks compliant",
        "authorship": "K"
      }
    ],
    "behavioral_requirements": [
      {
        "id": "REQ_DETECT_CORRUPTION",
        "statement": "Given a trace, proposal, or evidence set, the watcher scans all five codes and flags detected corruption with phase anchors and quotes.",
        "verification": "observed"
      },
      {
        "id": "REQ_NEAR_MISS_NO_FLAG",
        "statement": "A labeled machine draft (candidate {α'}) is not corruption; suspicion without violation yields CLEAN, never CORRUPT.",
        "verification": "observed"
      },
      {
        "id": "REQ_NO_CERTIFY",
        "statement": "The watcher never certifies or blesses a trace — the flag is a finding, recognition stays with H.",
        "verification": "observed"
      },
      {
        "id": "REQ_Q_SKIP_RESISTANCE",
        "statement": "The watcher flags L1 steering and Q-skip — machine proposing S or self-approving review — as CORRUPT.",
        "verification": "observed"
      },
      {
        "id": "REQ_MISSING_CONTEXT_OPEN",
        "statement": "Missing artifact or provenance keeps the scan open; no verdict is fabricated from unclear context.",
        "verification": "observed"
      },
      {
        "id": "REQ_REMOVAL_MEANINGFUL",
        "statement": "Removing the skill removes the scanning/verdict behavior — the skill is not decoration.",
        "verification": "observed"
      }
    ],
