      "priority": null,
      "normative": false,
      "warnings": []
    },
    {
      "id": "SRC-0002",
      "kind": "heading",
      "text": "5QLN Corruption Watcher",
      "sha256": "c6b51f4901005e787922af5d2a249bc518c445ffad992e3ba5fd8c0fdc8c173b",
      "source_file": "SKILL.md",
      "location": "line[13]",
