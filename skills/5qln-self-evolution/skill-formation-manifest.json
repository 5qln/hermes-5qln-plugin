  "contract": {
    "triggers": [
      {
        "id": "TR_1",
        "statement": "H says \"evolve the plugin\", \"form the next skill\", \"run an evolution cycle\"",
        "authorship": "K"
      },
      {
        "id": "TR_2",
        "statement": "H references a return question (∞0') from a prior cycle as the new spark",
        "authorship": "K"
      }
    ],
    "non_triggers": [
      {
        "id": "NTR_1",
        "statement": "Kernel amendment requests — kernel is sealed (kernel.txt, 217 bytes, sha256 feaa46b4…859b); refuse and reflect line 1",
        "authorship": "K"
      },
      {
        "id": "NTR_2",
        "statement": "Self-modification without a named H spark (L1)",
        "authorship": "K"
      },
      {
        "id": "NTR_3",
        "statement": "Promotion without accepted human review (L3 / V∅)",
        "authorship": "K"
      },
      {
        "id": "NTR_4",
        "statement": "Writing review evidence, calibration values, or certification language (L2)",
        "authorship": "K"
      }
    ],
    "behavioral_requirements": [
      {
        "id": "REQ_CYCLE_ON_SPARK",
        "statement": "H's explicit evolution command triggers the cycle; the loop runs S → G → Q → P → V without skipping phases.",
        "verification": "observed"
      },
      {
        "id": "REQ_NO_CYCLE_WITHOUT_SPARK",
        "statement": "Informational questions about evolution do not trigger a cycle — no S, no loop.",
        "verification": "observed"
      },
      {
        "id": "REQ_NO_CERTIFY",
        "statement": "The orchestrator never certifies autonomy or self-evolution — recognition stays with H.",
        "verification": "observed"
      },
      {
        "id": "REQ_NO_SELF_PROMOTION",
        "statement": "The orchestrator refuses to self-promote or write its own review evidence (L2/L3/V∅ guards).",
        "verification": "observed"
      },
      {
        "id": "REQ_SPARK_REQUIRED",
        "statement": "Without an H-verbatim spark, the cycle stays open at S — nothing evolves from a machine-named direction.",
        "verification": "observed"
      },
      {
        "id": "REQ_REMOVAL_MEANINGFUL",
        "statement": "Removing the skill removes the cycle-orchestration behavior — the skill is not decoration.",
        "verification": "observed"
      }
    ],
